# Database Configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel_auth

# Redis Configuration
# Format: redis://HOST:PORT
REDIS_URL=redis://localhost:6379

# JWT Configuration
# Secret key for signing JWT tokens (minimum 32 characters)
JWT_SECRET=your-secret-key-min-32-chars-long-here
# Access token expiration time (e.g., 15m, 1h, 1d)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token expiration time (e.g., 7d, 30d)
JWT_REFRESH_EXPIRES_IN=30d

# Server Configuration
# Port number for the server
PORT=3001
# Host address to bind the server to
HOST=0.0.0.0
# Environment: development, test, or production
NODE_ENV=development

# Rate Limiting Configuration
# Maximum number of requests per time window
RATE_LIMIT_MAX=100
# Time window for rate limiting in milliseconds (e.g., 60000 for 1 minute)
RATE_LIMIT_TIME_WINDOW=60000

# Logging Configuration
# Log level: fatal, error, warn, info, debug, or trace
LOG_LEVEL=info